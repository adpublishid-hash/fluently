NODE_ENV=production
PORT=4000
PUBLIC_APP_URL=https://app.fluently.id
GOOGLE_CLIENT_ID=100262738239-agmh7d6rkaficdvrfm2nbfbilne5m8k9.apps.googleusercontent.com

# Frontend domains allowed to call this API. Separate multiple domains with commas.
CORS_ORIGINS=https://app.fluently.id

# PostgreSQL
DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=fluently
DB_USER=fluently_user
DB_PASSWORD=replace-with-a-strong-password

# Admin bootstrap account
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# Shop notifications
ORDER_NOTIFY_EMAIL=orders@your-domain.com
QRIS_IMAGE_URL=https://your-domain.com/qris.png

# Shipping proxy
RAJAONGKIR_KEY=replace-with-komerce-rajaongkir-key
RAJAONGKIR_BASE=https://rajaongkir.komerce.id/api/v1

# Email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=no-reply@your-domain.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=no-reply@your-domain.com
SMTP_FROM_NAME=Fluently Support
SUPPORT_EMAIL=support@fluently.id

# WhatsApp notification provider
ONESENDER_URL=https://your-onesender-host/api/v1/messages
ONESENDER_KEY=replace-with-onesender-key
ONESENDER_ADMIN_PHONE=6285169167464

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# AI features. Server-paid requests go to Kie AI (OpenAI-compatible
# chat completions at KIE_BASE_URL/<KIE_MODEL>/v1/chat/completions).
KIE_API_KEY=
KIE_MODEL=gemini-3-8-flash
KIE_BASE_URL=https://api.kie.ai
# Legacy: used only when KIE_API_KEY is empty (a 32-char hex key is treated as Kie).
FREE_GEMINI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Daily AI requests per user paid by the server key (reset 00:00 WIB).
AI_DAILY_QUOTA_FREE=10
AI_DAILY_QUOTA_PRO=100
AI_DAILY_QUOTA_LIFETIME=150
# After the quota, learners can use their own free Google AI Studio key
# (sent per request in X-Gemini-Key, never stored). Model for those calls:
BYOK_GEMINI_MODEL=gemini-2.5-flash

# Max XP a user can earn per UTC day
DAILY_XP_CAP=3000
